{
  "entity": {
    "binary_sensor": {
      "shopping_trip_active": {
        "default": "mdi:cart-arrow-right",
        "state": {
          "off": "mdi:cart-outline"
        }
      },
      "home_for_dinner": {
        "default": "mdi:silverware"
      },
      "dinner_checkins_complete": {
        "default": "mdi:checkbox-marked-circle-outline"
      }
    },
    "button": {
      "heading_to_the_shops": {
        "default": "mdi:cart-arrow-right"
      }
    },
    "calendar": {
      "family": {
        "default": "mdi:calendar-multiple"
      },
      "member": {
        "default": "mdi:calendar-account"
      },
      "meals": {
        "default": "mdi:silverware-fork-knife"
      }
    },
    "sensor": {
      "tonights_dinner": {
        "default": "mdi:pot-steam"
      },
      "dinner_headcount": {
        "default": "mdi:account-group"
      },
      "list_remaining": {
        "default": "mdi:counter"
      },
      "next_event": {
        "default": "mdi:calendar-clock"
      }
    },
    "todo": {
      "list": {
        "default": "mdi:format-list-checks"
      },
      "grocery_list": {
        "default": "mdi:cart"
      }
    }
  },
  "services": {
    "add_event": {
      "service": "mdi:calendar-plus"
    },
    "set_dinner_checkin": {
      "service": "mdi:silverware-variant"
    },
    "set_meal": {
      "service": "mdi:pot-steam-outline"
    },
    "add_meal_ingredients_to_list": {
      "service": "mdi:cart-plus"
    },
    "add_list_item": {
      "service": "mdi:playlist-plus"
    },
    "start_shopping_trip": {
      "service": "mdi:cart-arrow-right"
    },
    "end_shopping_trip": {
      "service": "mdi:cart-check"
    },
    "search_recipes": {
      "service": "mdi:chef-hat"
    },
    "get_meal_plan": {
      "service": "mdi:calendar-text"
    }
  }
